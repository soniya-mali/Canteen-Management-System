<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"

    app:cardCornerRadius="16dp"
    app:cardElevation="5dp"
    app:cardBackgroundColor="#FFFDF8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- TOP SECTION -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <CheckBox
                android:id="@+id/selectItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <ImageView
                android:id="@+id/cartImage"
                android:layout_width="85dp"
                android:layout_height="85dp"
                android:layout_marginStart="6dp"
                android:scaleType="centerCrop"
                android:contentDescription="Food image" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/cartFoodName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Food Name"
                    android:textColor="#3E2723"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/cartFoodSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Size: Small"
                    android:textColor="#5D4037"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/cartFoodPrice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Price: ₹100"
                    android:textColor="#2E7D32"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/cartTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Total: ₹100"
                    android:textColor="#A67C52"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>


        <!-- QUANTITY SECTION -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">


            <!-- MINUS BUTTON -->

            <Button
                android:id="@+id/btnMinus"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:gravity="center"
                android:text="-"
                android:textColor="#4E342E"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:fontFamily="sans-serif"
                android:backgroundTint="#EADBC8" />


            <!-- QUANTITY -->

            <TextView
                android:id="@+id/cartQuantity"
                android:layout_width="50dp"
                android:layout_height="45dp"
                android:gravity="center"
                android:text="1"
                android:textColor="#3E2723"
                android:textSize="18sp"
                android:textStyle="bold" />


            <!-- PLUS BUTTON -->

            <Button
                android:id="@+id/btnPlus"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:gravity="center"
                android:text="+"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:fontFamily="sans-serif"
                android:backgroundTint="#A67C52" />


            <!-- SPACE -->

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />


            <!-- REMOVE BUTTON -->

            <Button
                android:id="@+id/btnRemove"
                android:layout_width="wrap_content"
                android:layout_height="45dp"
                android:text="Remove"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:backgroundTint="#B3261E" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>