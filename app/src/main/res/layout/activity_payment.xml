<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F3EC">

    <!-- ================================================= -->
    <!-- HEADER -->
    <!-- ================================================= -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="💳 Payment"
        android:textSize="30sp"
        android:textStyle="bold"
        android:textColor="#3E2723"
        android:padding="20dp"
        android:gravity="center"/>


    <!-- ================================================= -->
    <!-- PAYMENT METHOD TITLE -->
    <!-- ================================================= -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select Payment Method"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#5D4037"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"/>


    <!-- ================================================= -->
    <!-- PAYMENT METHODS -->
    <!-- ================================================= -->

    <RadioGroup
        android:id="@+id/paymentGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="15dp"
        android:paddingEnd="15dp">

        <RadioButton
            android:id="@+id/onlinePayment"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="▶ Online Payment"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#4E342E"
            android:paddingStart="12dp"/>

        <RadioButton
            android:id="@+id/cashOnDelivery"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="💵 Cash on Delivery"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#4E342E"
            android:paddingStart="12dp"/>

    </RadioGroup>


    <!-- ================================================= -->
    <!-- ORDER SUMMARY TITLE -->
    <!-- ================================================= -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Order Summary"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#5D4037"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="15dp"
        android:paddingBottom="8dp"/>


    <!-- ================================================= -->
    <!-- ORDER SUMMARY -->
    <!-- ================================================= -->

    <androidx.cardview.widget.CardView
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="15dp"
        android:layout_marginEnd="15dp"
        android:layout_marginBottom="10dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="6dp"
        app:cardBackgroundColor="#FFFDF8">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/orderSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pizza
Size: Small × 1
₹120"
                android:textSize="16sp"
                android:textColor="#4E342E"
                android:padding="18dp"/>

        </ScrollView>

    </androidx.cardview.widget.CardView>


    <!-- ================================================= -->
    <!-- TOTAL -->
    <!-- ================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Total"
            android:textSize="21sp"
            android:textStyle="bold"
            android:textColor="#5D4037"/>

        <TextView
            android:id="@+id/paymentTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹0"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="#2E7D32"/>

    </LinearLayout>


    <!-- ================================================= -->
    <!-- BUTTONS -->
    <!-- ================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        android:paddingTop="8dp"
        android:paddingBottom="20dp">

        <Button
            android:id="@+id/backBtn"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:text="← Back"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#4E342E"
            android:backgroundTint="#EADBC8"/>

        <Button
            android:id="@+id/placeOrderBtn"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Place Order 🚀"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#A67C52"/>

    </LinearLayout>

</LinearLayout>