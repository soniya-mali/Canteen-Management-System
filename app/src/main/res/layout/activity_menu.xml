<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F5F1"
    tools:ignore="ExtraText">

    <!-- ================= HEADER ================= -->

    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- PROFILE -->

        <ImageView
            android:id="@+id/profileImage"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/profile"
            android:background="@drawable/bg_profile_circle"
            android:padding="8dp"
            android:contentDescription="Profile" />

        <!-- USER NAME -->

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Welcome Back 👋"
                android:textSize="13sp"
                android:textColor="#9C8B75" />

            <TextView
                android:id="@+id/userName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Guest"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#3E2F28" />

        </LinearLayout>

        <!-- NOTIFICATION -->

        <ImageView
            android:id="@+id/notification"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:src="@drawable/notification"
            android:contentDescription="Notifications" />

    </LinearLayout>


    <!-- ================= TITLE ================= -->

    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Discover&#10;Delicious Food 🍽"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#3D312B"
        android:layout_marginStart="22dp"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ================= SEARCH ================= -->

    <androidx.cardview.widget.CardView
        android:id="@+id/searchCard"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginTop="20dp"
        app:cardCornerRadius="30dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#FFFDFB"
        app:layout_constraintTop_toBottomOf="@id/title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_search"
                android:contentDescription="Search" />

            <EditText
                android:id="@+id/searchBar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:minHeight="48dp"
                android:background="@android:color/transparent"
                android:paddingStart="12dp"
                android:gravity="center_vertical"
                android:hint="Search your favourite food..."
                android:textColor="#3E2F28"
                android:textColorHint="#B0A79C"
                android:textSize="16sp"
                android:singleLine="true" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>


    <!-- ================= CATEGORY ================= -->

    <HorizontalScrollView
        android:id="@+id/categoryScroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:scrollbars="none"
        app:layout_constraintTop_toBottomOf="@id/searchCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- ALL -->

            <Button
                android:id="@+id/btnAll"
                android:layout_width="wrap_content"
                android:layout_height="45dp"
                android:text="All"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:backgroundTint="#8D6E63" />

            <!-- BREAKFAST -->

            <Button
                android:id="@+id/btnBreakfast"
                android:layout_width="wrap_content"
                android:layout_height="45dp"
                android:layout_marginStart="10dp"
                android:text="Breakfast"
                android:textAllCaps="false"
                android:textColor="#5D4037"
                android:backgroundTint="#F3ECE4" />

            <!-- LUNCH -->

            <Button
                android:id="@+id/btnLunch"
                android:layout_width="wrap_content"
                android:layout_height="45dp"
                android:layout_marginStart="10dp"
                android:text="Lunch"
                android:textAllCaps="false"
                android:textColor="#5D4037"
                android:backgroundTint="#F3ECE4" />

            <!-- DINNER -->

            <Button
                android:id="@+id/btnDinner"
                android:layout_width="wrap_content"
                android:layout_height="45dp"
                android:layout_marginStart="10dp"
                android:text="Dinner"
                android:textAllCaps="false"
                android:textColor="#5D4037"
                android:backgroundTint="#F3ECE4" />

            <!-- SNACKS -->

            <Button
                android:id="@+id/btnSnacks"
                android:layout_width="wrap_content"
                android:layout_height="45dp"
                android:layout_marginStart="10dp"
                android:text="Snacks"
                android:textAllCaps="false"
                android:textColor="#5D4037"
                android:backgroundTint="#F3ECE4" />

            <!-- DRINKS -->

            <Button
                android:id="@+id/btnDrinks"
                android:layout_width="wrap_content"
                android:layout_height="45dp"
                android:layout_marginStart="10dp"
                android:text="Drinks"
                android:textAllCaps="false"
                android:textColor="#5D4037"
                android:backgroundTint="#F3ECE4" />

        </LinearLayout>

    </HorizontalScrollView>


    <!-- ================= FOOD GRID ================= -->

    <GridView
        android:id="@+id/gridView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:numColumns="2"
        android:verticalSpacing="12dp"
        android:horizontalSpacing="12dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false"
        android:scrollbars="vertical"
        android:fadeScrollbars="false"
        android:overScrollMode="always"
        android:stretchMode="columnWidth"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/categoryScroll"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/historyBtn" />


    <!-- ================= VIEW ORDERS ================= -->

    <Button
        android:id="@+id/historyBtn"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:text="📜 View Orders"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#8D6E63"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav" />


    <!-- ================= BOTTOM NAVIGATION ================= -->

    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#FFFDFB"
        android:elevation="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">


        <!-- ================= HOME ================= -->

        <LinearLayout
            android:id="@+id/homeNav"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/homeIcon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/home"
                android:scaleType="centerInside"
                android:contentDescription="Home" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#8B6F47"
                android:layout_marginTop="2dp" />

        </LinearLayout>


        <!-- ================= WISHLIST ================= -->

        <LinearLayout
            android:id="@+id/wishlistNav"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/wishlistIcon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/fav"
                android:scaleType="centerInside"
                android:contentDescription="Wishlist" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wishlist"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#8B6F47"
                android:layout_marginTop="2dp" />

        </LinearLayout>


        <!-- ================= CART ================= -->

        <LinearLayout
            android:id="@+id/cartNav"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/cartIcon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/cart"
                android:scaleType="centerInside"
                android:contentDescription="Cart" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cart"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#8B6F47"
                android:layout_marginTop="2dp" />

        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>